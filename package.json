{
  "name": "gaziantepli-taha-usta",
  "version": "1.0.0",
  "description": "Gaziantepli Taha Usta - Cari ve Personel Yonetim Sistemi",
  "main": "dist-electron/main.js",
  "author": "RYMedya",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.rymedya.gazianteplitahausta",
    "productName": "Gaziantepli Taha Usta",
    "copyright": "Copyright © 2026 RYMedya",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gaziantepli Taha Usta",
      "uninstallDisplayName": "Gaziantepli Taha Usta Yonetim Sistemi",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.4.3",
    "exceljs": "^4.4.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}