{
  "name": "gaziantepli-taha-usta",
  "version": "1.0.0",
  "description": "Gaziantepli Taha Usta - Cari ve Personel Yonetim Sistemi",
  "main": "dist-electron/main.js",
  "author": "RYMedya",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "electron:build": "vite build && electron-builder",
    "test": "vitest run",
    "build:web": "node tools/build-web-assets.cjs",
    "dev:testapi": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dev/start-test-api.ps1",
    "test:e2e": "node tools/dev/e2e-garson.cjs",
    "test:pwa": "node tools/dev/pwa-check.cjs http://127.0.0.1:8080/garson/"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.rymedya.gazianteplitahausta",
    "productName": "Gaziantepli Taha Usta",
    "copyright": "Copyright © 2026 RYMedya",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gaziantepli Taha Usta",
      "uninstallDisplayName": "Gaziantepli Taha Usta Yonetim Sistemi",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "cors": "^2.8.6",
    "decimal.js": "^10.4.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^5.0.5"
  }
}
