<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gaziantepli Taha Usta - Patron Canlı Takip Paneli</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#1C1C20] text-slate-100 font-sans p-6 min-h-screen">
  <div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between border-b border-[#2C2C34] pb-4">
      <div>
        <h1 class="text-xl font-black text-white">👑 Gaziantepli Taha Usta</h1>
        <p class="text-xs text-[#F5C877] font-bold">Patron Uzaktan Canlı Takip</p>
      </div>
      <div class="px-3 py-1 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 rounded-full text-xs font-bold flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Canlı Kasa Bağlı
      </div>
    </div>

    <!-- Anlık Ciro Kartları -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="p-5 bg-[#141416] border border-[#2C2C34] rounded-3xl">
        <div class="text-xs text-slate-400 font-bold uppercase">Bugünkü Toplam Ciro</div>
        <div class="text-3xl font-black text-emerald-400 mt-2">14.850 ₺</div>
      </div>
      <div class="p-5 bg-[#141416] border border-[#2C2C34] rounded-3xl">
        <div class="text-xs text-slate-400 font-bold uppercase">Dolu Masa Sayısı</div>
        <div class="text-3xl font-black text-[#F5C877] mt-2">18 / 27 Masa</div>
      </div>
      <div class="p-5 bg-[#141416] border border-[#2C2C34] rounded-3xl">
        <div class="text-xs text-slate-400 font-bold uppercase">Online Paket Sipariş</div>
        <div class="text-3xl font-black text-blue-400 mt-2">24 Adet</div>
      </div>
    </div>
  </div>
</body>
</html>
